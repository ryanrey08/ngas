# Base URL of the NGAS backend REST API (used only when NEXT_PUBLIC_API_MODE=real)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# "mock" uses the local mock data in src/mocks (default); "real" calls the backend through axios
NEXT_PUBLIC_API_MODE=mock

# Optional: request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=15000
