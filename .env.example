# ── Browser-visible ─────────────────────────────────────────────────────────────
# Base URL the browser calls. Keep the default: it is the same-origin proxy in
# src/app/api/backend, which forwards to the eNGAS backend and attaches the bearer token
# from an httpOnly cookie.
NEXT_PUBLIC_API_BASE_URL=/api/backend

# Data modules with no backend endpoints yet (journals, COA, reports…):
# "mock" uses src/mocks (default), "real" calls the backend. Authentication is ALWAYS real.
NEXT_PUBLIC_API_MODE=mock

# Browser request timeout in milliseconds
NEXT_PUBLIC_API_TIMEOUT=15000

# ── Server-only (never prefix with NEXT_PUBLIC_) ───────────────────────────────
# eNGAS system prefix of the NGAS backend API (Laravel, `make up` serves nginx on :8080)
NGAS_BACKEND_API_URL=http://localhost:8080/api/v1/engas

# Proxy → backend timeout in milliseconds
NGAS_BACKEND_TIMEOUT_MS=15000

# ── Docker (read by docker compose from a `.env` file, see docker/README.md) ───
# Inside a container `localhost` is the container itself. Docker Compose overrides
# NGAS_BACKEND_API_URL with this value; the default reaches a backend on the host's port 8080:
# NGAS_BACKEND_API_URL=http://host.docker.internal:8080/api/v1/engas
# Host port the frontend is published on, and the interface (127.0.0.1 behind a reverse proxy)
# FRONTEND_PORT=3000
# FRONTEND_BIND=0.0.0.0
# Production image name and tag
# FRONTEND_IMAGE=ngas-frontend
# FRONTEND_TAG=latest
